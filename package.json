{
  "name": "npmgraph",
  "version": "3.1.1",
  "description": "Visualize npm dependency graphs (public and private!)",
  "license": "MIT",
  "repository": "github:npmgraph/npmgraph",
  "funding": [
    "https://github.com/sponsors/broofa",
    "https://github.com/sponsors/fregante"
  ],
  "author": "Robert Kieffer (https://github.com/broofa)",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "vite build",
    "fetch-licenses": "node scripts/fetch_licenses.js",
    "start": "vite",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fix": "run-s --continue-on-error format lint:fix format",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "types": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test": "run-p format:check lint types test:unit build",
    "smoke": "vitest run --project smoke",
    "watch": "tsc --watch"
  },
  "keywords": [
    "npm",
    "dependencies",
    "dependency",
    "graph",
    "module"
  ],
  "dependencies": {
    "@bugsnag/js": "^9.0.0",
    "@hpcc-js/wasm-graphviz": "^1.29.2",
    "@visx/axis": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "canvas-confetti": "^1.9.4",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "filter-altered-clicks": "^2.1.1",
    "hosted-git-info": "^10.1.1",
    "module-replacements": "^3.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "select-dom": "^10.1.0",
    "simplur": "^4.1.1",
    "verkit": "^0.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@npm/types": "^2.1.0",
    "@sindresorhus/tsconfig": "^8.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.12",
    "@types/hosted-git-info": "^3.0.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-xo": "^6.0.0",
    "eslint-config-xo-react": "^0.32.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-react-doctor": "^0.9.17",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "lefthook": "^2.1.16",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-css-order": "^2.2.0",
    "sass": "^1.105.1",
    "svgo": "^4.1.0",
    "typed-query-selector": "^2.12.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.3.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
