{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "plugins": [{ "name": "typescript-plugin-css-modules" }],
    "types": ["node", "typed-query-selector"]
  }
}
